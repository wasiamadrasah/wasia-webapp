# NextAuth Configuration
NEXTAUTH_SECRET=your-secret-key-here-use-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-school-domain.edu.bd

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare R2 Configuration
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=school-system
CLOUDFLARE_R2_PUBLIC_URL=https://your-custom-domain.com

# Yahoo Mail Configuration (for Email OTP System)
# Use Yahoo App Password: https://login.yahoo.com/account/security
YAHOO_EMAIL=your-email@yahoo.com
YAHOO_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: Monitoring and Analytics
# SENTRY_DSN=
# DATADOG_API_KEY=
