# NextAuth Configuration
NEXTAUTH_SECRET=your-secret-key-here-use-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-school-domain.edu.bd

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare R2 Configuration
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=wasiamadrasah-webapp
CLOUDFLARE_R2_PUBLIC_URL=https://media.wasiamadrasah.edu.bd

# ==========================================
# Email & Mailer Configuration (Gmail / SMTP)
# ==========================================
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Sender Details (Display Name & From Address)
EMAIL_FROM_NAME="Wasia Madrasah"
EMAIL_FROM_ADDRESS=notifications@your-school-domain.edu.bd
EMAIL_REPLY_TO=info@your-school-domain.edu.bd

# Notification Routing (Where website inquiries & alerts go)
ADMIN_NOTIFICATION_EMAIL=admin@your-school-domain.edu.bd
ADMISSION_NOTIFICATION_EMAIL=admissions@your-school-domain.edu.bd

# Optional: Custom SMTP Transport (leave commented to use standard Gmail service)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# Optional: Monitoring and Analytics
# SENTRY_DSN=
# DATADOG_API_KEY=
